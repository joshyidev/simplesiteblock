{
  "manifest_version": 3,
  "name": "SimpleSiteBlock",
  "description": "Block sites from hosts-file and Adblock-syntax lists.",
  "version": "1.0.0",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "SimpleSiteBlock",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
